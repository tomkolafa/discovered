# Discovered — copy to .env.local and fill in. Never commit .env.local.

# ---- Supabase (new "Discovered" project) ----
# Dashboard > Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Same URL again, plus the SERVICE ROLE key (server-side only, used by /api/*)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Database password, only needed for `supabase db push`
SUPABASE_DB_PASSWORD=

# ---- Voice note transcription (required for transcripts) ----
# platform.openai.com/api-keys  — used for whisper-1 only
OPENAI_API_KEY=

# ---- Tag suggestions + plain-language report summary ----
# OpenRouter is used when set; Anthropic is the fallback. Set ONE of these.
# openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional override, default anthropic/claude-haiku-4.5
OPENROUTER_MODEL=
# console.anthropic.com/settings/keys  (only needed if OPENROUTER_API_KEY is blank)
ANTHROPIC_API_KEY=

# ---- Recap email (optional) ----
# resend.com/api-keys
RESEND_API_KEY=
# Sender. Needs a verified domain in Resend; without it Resend only delivers to your own address.
RECAP_FROM=
# Prefills the recap email field in the lobby
VITE_DEFAULT_RECAP_EMAIL=

# ---- App ----
APP_URL=
